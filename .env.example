FLASK_SECRET_KEY=changeme-generate-with-secrets-token-hex
FLASK_ENV=production
LOG_LEVEL=INFO
SITE_TITLE=80 ans
# Set to true when running behind a reverse proxy (e.g. Traefik) that terminates
# TLS, so Flask trusts X-Forwarded-Proto/Host and generates https:// URLs
# (needed for the OIDC redirect_uri).
BEHIND_PROXY=true

POSTGRES_DB=anniversaire80
POSTGRES_USER=anniversaire80
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql+psycopg://anniversaire80:changeme@db:5432/anniversaire80

RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL="Anniversaire 80 ans <invitation@votredomaine.fr>"

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: authenticate with an API key/secret pair instead of the account's
# auth token (see https://www.twilio.com/docs/iam/api-keys). TWILIO_ACCOUNT_SID
# above is still required. When both are set, the API key takes precedence
# over TWILIO_AUTH_TOKEN.
#TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#TWILIO_API_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+33600000000
# Optional: target a specific Twilio region/edge (see
# https://github.com/twilio/twilio-python#specify-region-andor-edge).
# Leave unset to use Twilio's default routing.
#TWILIO_REGION=au1
#TWILIO_EDGE=sydney

OIDC_ISSUER=https://pocketid.example.com
OIDC_CLIENT_ID=xxxxxxxxxxxxxxxx
OIDC_CLIENT_SECRET=xxxxxxxxxxxxxxxx
